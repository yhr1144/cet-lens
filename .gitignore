dist/
build/
tmp/
ui-test/
build-tools/
node_modules/
.android-home/

# ---- 签名与密钥 ----
*.keystore
*.jks
*.env
ks.env
vendor/shell-v1.1.0.apk

# ---- 根目录一次性补丁脚本（不进仓库）----
